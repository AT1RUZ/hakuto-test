---
const planes = [
  {
    id: "esencial",
    name: "Esencial",
    price: 49,
    tag: "Entrada",
    accent: "attention" as const,
    features: ["Médico general 24/7", "Urgencias básicas", "Farmacia online 15%"],
  },
  {
    id: "equilibrio",
    name: "Equilibrio",
    price: 89,
    tag: "Recomendado",
    accent: "protected" as const,
    features: ["Especialistas sin derivación", "Hospitalización 80%", "Dental + óptica"],
  },
  {
    id: "integral",
    name: "Integral",
    price: 149,
    tag: "Premium",
    accent: "protected" as const,
    features: ["Cobertura global", "Hospitalización 100%", "Segunda opinión médica"],
  },
];
---

<section
  id="planes"
  class="relative scroll-mt-24 overflow-hidden py-24 md:py-32"
  data-section="resultados"
>
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-protected">Resultados</p>
      <h2 class="mt-3 font-display text-4xl text-foreground md:text-5xl">
        Tres capas de cobertura
      </h2>
      <p class="mt-4 text-muted-foreground">
        Las cartas giran hacia ti. El plan recomendado se ilumina según tu cotización.
      </p>
    </div>

    <div
      class="mt-14 grid gap-6 md:grid-cols-3"
      data-plan-grid
      style="perspective: 1200px;"
    >
      {
        planes.map((plan) => (
          <article
            class="plan-card group relative rounded-2xl border border-border bg-card p-6 shadow-soft transition-[opacity,filter] duration-300"
            data-plan-card
            data-plan-id={plan.id}
            style="transform-style: preserve-3d;"
          >
            <div class="flex items-center justify-between">
              <span
                class:list={[
                  "rounded-sm px-2 py-1 font-mono text-[10px] uppercase tracking-[0.16em]",
                  plan.accent === "protected"
                    ? "border border-protected/40 text-protected"
                    : "border border-attention/40 text-attention",
                ]}
              >
                {plan.tag}
              </span>
              <span class="font-mono text-[10px] text-muted-foreground">EUR / mes</span>
            </div>
            <h3 class="mt-5 font-display text-3xl text-foreground">{plan.name}</h3>
            <p class="mt-4 font-mono text-4xl text-foreground">
              <span data-count-up={plan.price}>0</span>
              <span class="text-base text-muted-foreground">€</span>
            </p>
            <ul class="mt-6 space-y-3 text-sm text-muted-foreground">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2">
                  <span
                    class:list={[
                      "mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full",
                      plan.accent === "protected" ? "bg-protected" : "bg-attention",
                    ]}
                    aria-hidden="true"
                  />
                  {f}
                </li>
              ))}
            </ul>
            <a
              href="/#cta-final"
              class:list={[
                "mt-8 inline-flex h-11 w-full items-center justify-center rounded-md text-sm font-semibold transition-opacity hover:opacity-90",
                plan.id === "equilibrio"
                  ? "bg-protected text-primary-foreground"
                  : "border border-border text-foreground hover:border-protected/50",
              ]}
            >
              Seleccionar
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
