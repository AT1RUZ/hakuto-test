---
import { SITE_CONTACT, SITE_NAME } from "@/lib/site";
---

<footer class="border-t border-border bg-surface">
  <div class="container grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl text-foreground">{SITE_NAME}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground">
        Protección de salud premium con cobertura transparente. Cotiza en minutos y elige el plan
        que se adapta a tu ritmo.
      </p>
    </div>
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Navegación</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="text-foreground/80 hover:text-protected" href="/#cotizador">Cotizador</a></li>
        <li><a class="text-foreground/80 hover:text-protected" href="/#planes">Planes</a></li>
        <li><a class="text-foreground/80 hover:text-protected" href="/#comparador">Comparador</a></li>
        <li><a class="text-foreground/80 hover:text-protected" href="/#faq">FAQ</a></li>
      </ul>
    </div>
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">Contacto</p>
      <ul class="mt-4 space-y-2 text-sm text-foreground/80">
        {
          SITE_CONTACT.email && (
            <li>
              <a class="hover:text-protected" href={`mailto:${SITE_CONTACT.email}`}>
                {SITE_CONTACT.email}
              </a>
            </li>
          )
        }
        <li class="text-muted-foreground">Lun–Vie · 9:00–18:00</li>
      </ul>
    </div>
  </div>
  <div
    class="border-t border-border/70 py-5 text-center font-mono text-[11px] tracking-wide text-muted-foreground"
  >
    © {new Date().getFullYear()} {SITE_NAME}. Producto demostrativo.
  </div>
</footer>
