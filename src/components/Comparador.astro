---
const rows = [
  {
    feature: "Médico general 24/7",
    values: [true, true, true],
  },
  {
    feature: "Especialistas sin derivación",
    values: [false, true, true],
  },
  {
    feature: "Hospitalización",
    values: ["60%", "80%", "100%"],
  },
  {
    feature: "Dental + óptica",
    values: [false, true, true],
  },
  {
    feature: "Cobertura internacional",
    values: [false, false, true],
  },
  {
    feature: "Segunda opinión médica",
    values: [false, false, true],
  },
];

const plans = ["Esencial", "Equilibrio", "Integral"];
---

<section
  id="comparador"
  class="relative scroll-mt-24 overflow-hidden py-24 md:py-32"
  data-section="comparador"
>
  <div class="container mb-10">
    <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-protected">Comparador</p>
    <h2 class="mt-3 max-w-xl font-display text-4xl text-foreground md:text-5xl">
      Cobertura lado a lado
    </h2>
    <p class="mt-4 max-w-lg text-muted-foreground">
      Desplaza horizontalmente el track fijado: cada fila revela el estado con precisión de
      señal.
    </p>
  </div>

  <div class="relative" data-compare-pin>
    <div class="overflow-hidden" data-compare-viewport>
      <div
        class="flex w-max gap-0 px-4 md:px-[max(1rem,calc((100vw-1280px)/2+1.5rem))]"
        data-compare-track
      >
        <div class="w-[min(92vw,720px)] shrink-0 rounded-2xl border border-border bg-card p-6 shadow-medium md:p-8">
          <div class="mb-6 grid grid-cols-[1.4fr_repeat(3,0.7fr)] gap-3 border-b border-border pb-4 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground">
            <span>Prestación</span>
            {plans.map((p) => <span class="text-center text-foreground/80">{p}</span>)}
          </div>
          <div class="space-y-0">
            {
              rows.map((row) => (
                <div
                  class="compare-row grid grid-cols-[1.4fr_repeat(3,0.7fr)] items-center gap-3 border-b border-border/60 py-4 opacity-40"
                  data-compare-row
                >
                  <span class="text-sm text-foreground/90">{row.feature}</span>
                  {row.values.map((v) => (
                    <span class="flex justify-center">
                      {typeof v === "boolean" ? (
                        v ? (
                          <svg
                            class="compare-check h-5 w-5 text-protected"
                            viewBox="0 0 24 24"
                            fill="none"
                            aria-label="Incluido"
                          >
                            <path
                              d="M5 13 L10 18 L19 7"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              pathLength="1"
                              style="stroke-dasharray: 1; stroke-dashoffset: 1;"
                              data-check-path
                            />
                          </svg>
                        ) : (
                          <span class="font-mono text-xs text-muted-foreground" aria-label="No incluido">
                            —
                          </span>
                        )
                      ) : (
                        <span class="font-mono text-sm text-attention">{v}</span>
                      )}
                    </span>
                  ))}
                </div>
              ))
            }
          </div>
        </div>

        <div class="flex w-[min(88vw,480px)] shrink-0 items-center px-6 md:px-12">
          <div class="rounded-2xl border border-protected/30 bg-protected/5 p-8">
            <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-protected">Lectura</p>
            <p class="mt-3 font-display text-3xl text-foreground">
              El detalle decide. El precio solo informa.
            </p>
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
              Compara hospitalización, especialistas y extras sin tablas densas: cada fila entra
              cuando el track lo pide.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
