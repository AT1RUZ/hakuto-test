---
---

<section
  id="cta-final"
  class="relative scroll-mt-24 overflow-hidden py-28 md:py-36"
  data-section="cta"
>
  <div
    class="shield-blob pointer-events-none absolute left-1/2 top-1/2 z-0 h-[min(80vw,560px)] w-[min(80vw,560px)] -translate-x-1/2 -translate-y-1/2 border border-protected/30 bg-protected/[0.08] shadow-glow-protected"
    data-shield-final
    aria-hidden="true"
  ></div>

  <div class="container relative z-10 text-center">
    <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-protected">Listo</p>
    <h2 class="mx-auto mt-4 max-w-3xl font-display text-4xl text-foreground md:text-6xl">
      Activa tu escudo. Empieza protegido.
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-muted-foreground">
      Vuelve al cotizador o solicita contacto. El borde del botón late como un status signal —
      estable, no juguetón.
    </p>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/#cotizador"
        class="magnetic-btn glow-border relative inline-flex h-14 items-center overflow-hidden rounded-md bg-protected px-8 text-sm font-semibold text-primary-foreground"
        data-magnetic
      >
        <span class="pointer-events-none absolute inset-0 rounded-md border border-protected/80 opacity-70" data-glow-ring aria-hidden="true"></span>
        Cotizar de nuevo
      </a>
      <a
        href="mailto:hola@escudocinetico.example"
        class="inline-flex h-14 items-center rounded-md border border-border px-8 text-sm font-medium text-foreground transition-colors hover:border-attention/50 hover:text-attention"
      >
        Hablar con un asesor
      </a>
    </div>
  </div>
</section>
